        {
          "i": 25,
          "c": "a"
        },
        {
          "i": 26,
          "c": "e"
        }
      ],
      "transform": [
        {
          "type": "formula",
          "as": "deg",
          "expr": "bottomStartDeg + (bottomEndDeg - bottomStartDeg) * datum.i / (bottomCount - 1)"
        },
        {
          "type": "formula",
          "as": "theta",
          "expr": "(90 - datum.deg) * PI / 180"
        },
        {
          "type": "formula",
          "as": "x",
          "expr": "cx + r * cos(datum.theta)"
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "cy + r * sin(datum.theta)"
        },
        {
          "type": "formula",
          "as": "angle",
          "expr": "-datum.deg"
        }
      ]
    },
    {
      "name": "triangle",
      "values": [
        {
          "i": 0,
          "angle": 210
        },
        {
          "i": 1,
          "angle": 330
        },
        {
          "i": 2,
          "angle": 90
        },
        {
          "i": 3,
          "angle": 210
        }
      ],
      "transform": [
        {
          "type": "formula",
          "as": "theta",
          "expr": "datum.angle * PI / 180"
        },
        {
          "type": "formula",
          "as": "x",
          "expr": "cx + triangleR * cos(datum.theta) + triangleOffset"
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "cy + triangleR * sin(datum.theta) + triangleOffset"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "arc",
      "encode": {
        "enter": {
          "x": {
            "signal": "cx"
          },
          "y": {
            "signal": "cy"
          },
          "startAngle": {
            "value": 0
          },
          "endAngle": {
            "signal": "2 * PI"
          },
          "innerRadius": {
            "signal": "innerR"
          },
          "outerRadius": {
            "signal": "innerR"
          },
          "stroke": {
            "value": "#1428A0"
          },
          "strokeWidth": {
            "signal": "lineWidth"
          },
          "fill": {
            "value": null
          }
        }
      }
    },
    {
      "type": "line",
      "from": {
        "data": "triangle"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "stroke": {
            "value": "#1428A0"
          },
          "strokeWidth": {
            "signal": "lineWidth"
          },
          "fill": {
            "value": null
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "topLetters"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "text": {
            "field": "c"
          },
          "angle": {
            "field": "angle"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "CommitMono"
          },
          "fontSize": {
            "value": 60
          },
          "fill": {
            "value": "#1428A0"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "bottomLetters"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "text": {
            "field": "c"
          },
          "angle": {
