{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 600,
  "height": 600,
  "padding": 10,
  "autosize": "none",
  "signals": [
    {
      "name": "cx",
      "value": 300
    },
    {
      "name": "cy",
      "value": 300
    },
    {
      "name": "r",
      "value": 290
    },
    {
      "name": "innerR",
      "update": "r - 28"
    },
    {
      "name": "triangleR",
      "update": "innerR - 2"
    },
    {
      "name": "lineWidth",
      "value": 6
    },
    {
      "name": "triangleOffset",
      "value": -1
    },
    {
      "name": "topStartDeg",
      "value": -90
    },
    {
      "name": "topEndDeg",
      "value": 90
    },
    {
      "name": "topCount",
