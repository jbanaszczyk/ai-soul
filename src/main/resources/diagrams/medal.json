        {
          "i": 20,
          "c": "s"
        }
      ],
      "transform": [
        {
          "type": "formula",
          "as": "deg",
          "expr": "topStartDeg + (topEndDeg - topStartDeg) * datum.i / (topCount - 1)"
        },
        {
          "type": "formula",
          "as": "theta",
          "expr": "(datum.deg - 90) * PI / 180"
        },
        {
          "type": "formula",
          "as": "x",
          "expr": "cx + r * cos(datum.theta)"
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "cy + r * sin(datum.theta)"
        },
        {
          "type": "formula",
          "as": "angle",
          "expr": "datum.deg"
        }
      ]
    },
    {
